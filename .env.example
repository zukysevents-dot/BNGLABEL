# Spotify API — Client Credentials Flow (server-side only)
# Vytvoř appku na https://developer.spotify.com/dashboard a vlož sem ID a secret.
# Tyto proměnné se NIKDY neposílají do prohlížeče (čtou se jen v server kódu).
# Bez nich web jede na mock datech z data/artists.ts.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Sentry — error monitoring (volitelné)
# DSN je veřejné (posílá se do prohlížeče). Bez něj je Sentry vypnuté.
# Vezmeš ho v Sentry: Settings → Projects → zakazka → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=

# Auth token jen pro upload source map při buildu (CI / Vercel).
# Sentry: Settings → Auth Tokens. NIKDY se neposílá do prohlížeče.
SENTRY_AUTH_TOKEN=
